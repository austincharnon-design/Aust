local LocalPlayer=Players.LocalPlayer local SPEED=80 local flying=false local bv,bg,conn
local function cleanup() flying=false if conn then conn:Disconnect() conn=nil end local c=LocalPlayer.Character if c then local r=c:FindFirstChild("HumanoidRootPart") if r then local a=r:FindFirstChild("AdminFlyVelocity") if a then a:Destroy() end local b=r:FindFirstChild("AdminFlyGyro") if b then b:Destroy() end end local h=c:FindFirstChildOfClass("Humanoid") if h then h.PlatformStand=false end end end
