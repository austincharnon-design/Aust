local function styleButton(b, accent)
	b.BackgroundColor3 = accent and C.accent2 or C.surface2
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.Font = Enum.Font.Gotham
	b.TextSize = 13
	b.TextColor3 = C.text
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	local s = Instance.new("UIStroke", b) s.Color = C.border s.Thickness = 1 s.Transparency = 0.4
end

local function makeActionButton(parent, label, actionName, useTargets)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 34)
	b.Text = label
	b.Parent = parent
	styleButton(b)

	b.MouseButton1Click:Connect(function()
		local fn = Actions[actionName]
		if not fn then
			warn("Unknown action "..actionName)
			return
		end

		task.spawn(function()
			if useTargets then
				local ts = resolveTargets()
				if #ts == 0 then
					warn("[AustAdmin] no targets")
					return
				end
				for _, t in ipairs(ts) do
					local ok, err = pcall(fn, t)
					if not ok then
						warn("[AustAdmin] '"..actionName.."' on "..t.Name.." failed:", err)
					else
						print("[AustAdmin] '"..actionName.."' ran on "..t.Name)
					end
				end
			else
				local ok, err = pcall(fn, me)
				if not ok then
					warn("[AustAdmin] '"..actionName.."' failed:", err)
				else
					print("[AustAdmin] '"..actionName.."' ran OK")
				end
			end
		end)
	end)
end

