local function cmdBring(ts)
	local _,_,mr = getCh(me) if not mr then return end
	for _,t in ipairs(ts) do local _,h,r=getCh(t) if r then if h then h.Sit=false end r.CFrame=mr.CFrame+Vector3.new(3,1,0) end end
end
local function cmdGoto(ts)
	local tgt=ts[1] if not tgt then return end
	local _,_,r=getCh(tgt) local _,_,mr=getCh(me)
	if r and mr then mr.CFrame=r.CFrame+Vector3.new(3,1,0) end
end
local function cmdLoopBring(ts,distance,delayS)
	distance=tonumber(distance) or 3 delayS=tonumber(delayS) or 0
	for _,t in ipairs(ts) do
		if not loopBring[t] then loopBring[t]=true
			task.spawn(function()
				while loopBring[t] and t.Parent do
					local _,_,r=getCh(t) local _,_,mr=getCh(me)
					if r and mr then r.CFrame=mr.CFrame+Vector3.new(distance,1,0) end
					task.wait(delayS)
				end
			end)
		end
	end
end
local function cmdUnloopBring(ts) for _,t in ipairs(ts) do loopBring[t]=nil end end
local function cmdFollow(ts)
	if followConn then followConn:Disconnect() followConn=nil end
	local tgt=ts[1] if not tgt then return end
	followConn = RunService.Heartbeat:Connect(function()
		local _,h=getCh(me) local _,_,r=getCh(tgt)
		if h and r then h:MoveTo(r.Position) end
	end)
end
local function cmdUnfollow() if followConn then followConn:Disconnect() followConn=nil end end
