-- target selection
------------------------------------------------------------
local selectedTargetMode = "me"
local namedTargetText = ""

local function matchesName(p, q)
	q = string.lower(q)
	local n, d = string.lower(p.Name), string.lower(p.DisplayName)
	if n == q or d == q then return 3 end
	if string.sub(n,1,#q)==q or string.sub(d,1,#q)==q then return 2 end
	if string.find(n,q,1,true) or string.find(d,q,1,true) then return 1 end
	return 0
end

local function resolveTargets()
	local t = {}
	if selectedTargetMode == "me" then
		table.insert(t, me)
	elseif selectedTargetMode == "all" then
		for _,p in ipairs(Players:GetPlayers()) do table.insert(t,p) end
	elseif selectedTargetMode == "others" then
		for _,p in ipairs(Players:GetPlayers()) do if p~=me then table.insert(t,p) end end
	elseif selectedTargetMode == "random" then
		local l = Players:GetPlayers()
		if #l>0 then table.insert(t, l[math.random(1,#l)]) end
	elseif selectedTargetMode == "named" then
		local seen = {}
		for _, part in ipairs(string.split(namedTargetText, ",")) do
			part = part:gsub("^%s+",""):gsub("%s+$","")
			if part ~= "" then
				local best, bestP = 0, nil
				for _, p in ipairs(Players:GetPlayers()) do
					local s = matchesName(p, part)
					if s > best then best, bestP = s, p end
				end
				if bestP and not seen[bestP] then
					seen[bestP] = true
					table.insert(t, bestP)
				end
			end
		end
	end
	return t
end

local function getCh(p)
	local c = p.Character
	if not c then return nil, nil, nil end
	return c, c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

