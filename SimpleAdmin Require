	lbl.TextXAlignment = Enum.TextXAlignment.Left lbl.ZIndex = 52 lbl.Parent = box

	local tb = Instance.new("TextBox")
	tb.Size = UDim2.new(1,-24,0,36) tb.Position = UDim2.new(0,12,0,52)
	tb.BackgroundColor3 = C.surface2 tb.BorderSizePixel = 0
	tb.PlaceholderText = placeholder or "" tb.Text = "" tb.ClearTextOnFocus = false
	tb.Font = Enum.Font.Gotham tb.TextSize = 13 tb.TextColor3 = C.text
	tb.PlaceholderColor3 = C.textDim tb.ZIndex = 52 tb.Parent = box
	Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 8)
	local ts = Instance.new("UIStroke", tb) ts.Color = C.border ts.Thickness = 1

	local ok = Instance.new("TextButton")
	ok.Size = UDim2.new(0,150,0,34) ok.Position = UDim2.new(1,-162,1,-46)
	ok.Text = "Run" ok.Font = Enum.Font.GothamBold ok.TextSize = 13 ok.TextColor3 = Color3.new(1,1,1)
	ok.BackgroundColor3 = C.accent2 ok.BorderSizePixel = 0 ok.ZIndex = 52 ok.Parent = box
	Instance.new("UICorner", ok).CornerRadius = UDim.new(0, 8)

	local cancel = Instance.new("TextButton")
	cancel.Size = UDim2.new(0,96,0,34) cancel.Position = UDim2.new(0,12,1,-46)
	cancel.Text = "Cancel" cancel.Font = Enum.Font.Gotham cancel.TextSize = 13 cancel.TextColor3 = C.text
	cancel.BackgroundColor3 = C.surface2 cancel.BorderSizePixel = 0 cancel.ZIndex = 52 cancel.Parent = box
	Instance.new("UICorner", cancel).CornerRadius = UDim.new(0, 8)

	tb:CaptureFocus()
	local function finish(run)
		local val = tb.Text
		dim:Destroy()
		if run then task.spawn(function() local okr,err=pcall(callback,val) if not okr then warn("[AustAdmin] cmd failed:",err) end end) end
	end
	ok.MouseButton1Click:Connect(function() finish(true) end)
	cancel.MouseButton1Click:Connect(function() finish(false) end)
	tb.FocusLost:Connect(function(e) if e then finish(true) end end)
end

