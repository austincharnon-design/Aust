local function rowAdder(parent)
	local cur, left = nil, 0
	return function(label, fn)
		if left == 0 then
			cur = Instance.new("Frame")
			cur.Size = UDim2.new(1, 0, 0, 34)
			cur.BackgroundTransparency = 1
			cur.Parent = parent
			local l = Instance.new("UIListLayout", cur)
			l.FillDirection = Enum.FillDirection.Horizontal
			l.Padding = UDim.new(0, 6)
			left = 2
		end
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0.5, -3, 1, 0)
		b.Text = label b.Parent = cur
		styleButton(b)
		b.MouseButton1Click:Connect(function()
			task.spawn(function()
				local ok, err = pcall(fn)
				if not ok then warn("[AustAdmin] cmd failed:", err) end
			end)
		end)
		left = left - 1
	end
end

