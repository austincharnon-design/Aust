local noclipSource = [[
local Players=game:GetService("Players") local RunService=game:GetService("RunService")
local LocalPlayer=Players.LocalPlayer local flag=LocalPlayer:WaitForChild("AustAdminNoclipState") local conn
local function start() if conn then conn:Disconnect() end conn=RunService.Stepped:Connect(function() if not flag.Value then return end local c=LocalPlayer.Character if not c then return end for _,v in ipairs(c:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide=false end end end) end
flag:GetPropertyChangedSignal("Value"):Connect(function() if flag.Value then start() elseif conn then conn:Disconnect() conn=nil end end)
if flag.Value then start() end
]]

local function installLocalFor(plr, name, src)
	local pg = plr:FindFirstChildOfClass("PlayerGui")
	if not pg then return end
	local ex = pg:FindFirstChild(name)
	if ex then ex:Destroy() end
	local ls = Instance.new("LocalScript")
	ls.Name = name
	ls.Source = src
	ls.Parent = pg
end

local function startFly(ts)
	for _,plr in ipairs(ts) do
		ensureFlagFor(plr, "AustAdminFlyState").Value = true
		installLocalFor(plr, "AustAdminFlyClient", flyClientSource)
	end
end

local function stopFly(ts)
	for _,plr in ipairs(ts) do
		ensureFlagFor(plr, "AustAdminFlyState").Value = false
	end
end

local function startNoclipFor(ts)
	for _,plr in ipairs(ts) do
		ensureFlagFor(plr, "AustAdminNoclipState").Value = true
		installLocalFor(plr, "AustAdminNoclipClient", noclipSource)
	end
end

local function stopNoclipFor(ts)
	for _,plr in ipairs(ts) do
		ensureFlagFor(plr, "AustAdminNoclipState").Value = false
	end
end

