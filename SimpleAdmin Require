	tab.MouseButton1Click:Connect(function() setActive(entry) end)
	tab.MouseEnter:Connect(function() if not page.Visible then tab.BackgroundColor3 = C.surface2 end end)
	tab.MouseLeave:Connect(function() if not page.Visible then tab.BackgroundColor3 = C.surface end end)
	table.insert(pages, entry)
	return page, entry
